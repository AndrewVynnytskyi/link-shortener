# Runtime environment: development | production | test
NODE_ENV=development

# Port the Nest HTTP server listens on
PORT=3000

# MongoDB connection string
DATABASE_URL=mongodb://localhost:27017/link-shortener

# Secret used to sign/verify JWTs. Generate a strong random value, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# How long an issued JWT (and its cookie) stays valid. Supports <n>s|m|h|d.
JWT_EXPIRES_IN=2d

# Origin allowed by CORS and the value the frontend is served from
FRONTEND_URL=http://localhost:3001

# Optional: cookie Domain attribute for the auth cookie (leave unset for host-only)
COOKIE_DOMAIN=

# Rate limiting: window (ms) and max requests per window, per client
THROTTLE_TTL=60000
THROTTLE_LIMIT=20
