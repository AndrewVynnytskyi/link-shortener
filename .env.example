# Environment variables for `docker compose up` (see docker-compose.yml).
# Copy this file to `.env` and fill in real values before running Compose.
# Running each app outside Docker? Use backend/.env.example and
# frontend/.env.example instead.

# --- backend --------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2d
FRONTEND_URL=http://localhost:3001
THROTTLE_TTL=60000
THROTTLE_LIMIT=20

# --- frontend ---------------------------------------------------------
# Must be reachable from the browser; see the comment in docker-compose.yml.
NEXT_PUBLIC_API_URL=http://localhost:3000
